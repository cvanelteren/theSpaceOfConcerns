# --- Derived data ----------------------------------------------------------
# output/ holds ~150 MB of intermediates. Only the files the paper's figure
# scripts actually read are committed, and they are force-added so that this
# blanket ignore cannot silently drop them again. Run `make check-data` (or
# scripts/check_required_data.py) to verify the committed set still covers
# every path referenced by a figure script.
output/*
!output/.gitkeep
# Final formal-output validation is an irreplaceable audit record rather than
# a regenerable intermediate. Keep the protocol, blind decisions, consensus,
# and compact result tables visible to version control.
!output/outcome_linkage/
output/outcome_linkage/*
!output/outcome_linkage/outcome_consensus_coding_protocol.md
!output/outcome_linkage/outcome_consensus_*coder*.csv
!output/outcome_linkage/outcome_consensus_*adjudicated.csv
!output/outcome_linkage/outcome_consensus_*audit.csv
!output/outcome_linkage/outcome_consensus_*arbitration.csv
!output/outcome_linkage/outcome_consensus_*final.csv
!output/outcome_linkage/outcome_consensus_*agreement*.csv
!output/outcome_linkage/outcome_consensus_*blind.csv
!output/outcome_linkage/outcome_consensus_*unanimous.csv
!output/outcome_linkage/outcome_consensus_*provisional.csv
!output/outcome_linkage/outcome_consensus_*revisions*.csv
!output/outcome_linkage/outcome_consensus_*scope_key.csv
!output/outcome_linkage/outcome_consensus_validation_*.csv
!output/outcome_linkage/outcome_consensus_validation_summary.json
!output/outcome_linkage/outcome_consensus_model_comparison.csv
!output/outcome_linkage/outcome_consensus_sampling_strata.csv
